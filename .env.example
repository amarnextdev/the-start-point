# Copy this file to .env.local and fill in the real values.
# Never commit .env.local.

# Public site URL (used for SEO, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string (phase 3)
MONGODB_URI=

# Session signing secret — generate with: npx auth secret  (or any 32+ char random string)
AUTH_SECRET=

# Cloudinary (phase 6)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — email alert on new enquiry (phase 3)
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
